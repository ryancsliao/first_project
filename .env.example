# --- eBay Browse API credentials (required) ---
# Create a developer account at https://developer.ebay.com/, create an
# application, and grab its Production "Client ID" / "Client Secret"
# (App ID / Cert ID). These are used for a client-credentials ("Application")
# OAuth token, which only grants read access to public browse data -
# no user login/consent needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# "PRODUCTION" (real listings) or "SANDBOX" (eBay's fake test data)
EBAY_ENV=PRODUCTION

# Which eBay marketplace to search (see eBay docs for other MARKETPLACE_ID values)
EBAY_MARKETPLACE_ID=EBAY_US

# eBay category ID to restrict searches to. Default is "Pokemon Individual
# Cards". If results look wrong, browse ebay.com, find the category in the
# URL (mkcid/... or "categories/183454"), and update this.
EBAY_CATEGORY_ID=183454

# --- pokemontcg.io API key (optional but recommended) ---
# Free key from https://pokemontcg.io/ - raises the rate limit well beyond
# what an unauthenticated key gets you. Leave blank to use the public tier.
POKEMONTCG_API_KEY=

# Default minimum discount (percent below TCGPlayer market price) required
# for a listing to be reported as a "deal".
DEFAULT_MIN_DISCOUNT_PCT=20
